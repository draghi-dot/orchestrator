{
  "name": "baton",
  "productName": "Baton",
  "version": "0.1.0",
  "private": true,
  "description": "Baton orchestrates AI agents that test software, review each other, and verify every finding.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:isolated": "QA_TEST_NO_TCP=1 vitest run",
    "test:live": "vitest run --config vitest.live.config.mts",
    "check:desktop": "electron scripts/desktop-check.cjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-vite": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
